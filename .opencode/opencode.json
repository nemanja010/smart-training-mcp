{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "intervals-icu": {
      "type": "local",
      "command": ["intervals-mcp"],
      "environment": {
        "API_KEY": "{env:API_KEY}",
        "ATHLETE_ID": "{env:ATHLETE_ID}"
      },
      "enabled": true
    },
    "paper-search": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "paper-search-mcp",
        "--with",
        "mcp<2",
        "paper-search-mcp"
      ],
      "enabled": true
    }
  }
}
