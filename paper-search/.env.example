# Paper Search MCP — Optional API Keys
#
# Copy this file to:
#   ~/.config/paper-search-mcp/.env     (Linux/macOS)
#   %USERPROFILE%\.config\paper-search-mcp\.env   (Windows)
#
# The paper-search MCP server auto-loads this file on startup.
# Environment variables take precedence over values here.
# To use a different location, set PAPER_SEARCH_MCP_ENV_FILE=/absolute/path/to/.env
#
# Every key below is OPTIONAL. The server works keyless out of the box —
# add keys only when a source is rate-limiting you.

# ---------------------------------------------------------------------------
# REQUIRED for the Unpaywall source and the Unpaywall leg of the
# download_with_fallback chain. Without it, that source is disabled entirely.
# Any valid email works: https://unpaywall.org/products/api
# ---------------------------------------------------------------------------
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=your_email_here

# ---------------------------------------------------------------------------
# Optional — raise rate limits / improve metadata
# ---------------------------------------------------------------------------

# CORE — strongly recommended; without it searches are throttled and often 500.
# Free: https://core.ac.uk/services/api
# PAPER_SEARCH_MCP_CORE_API_KEY=

# Semantic Scholar — raises the anonymous rate limit (429s are common keyless).
# Free: https://www.semanticscholar.org/product/api
# PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex — roughly 10x the keyless daily budget.
# Free: https://openalex.org/settings/api
# PAPER_SEARCH_MCP_OPENALEX_API_KEY=

# Contact email placed in the OpenAlex User-Agent (polite, not rate limiting).
# PAPER_SEARCH_MCP_OPENALEX_EMAIL=

# DOAJ — raises the hourly limit (keyless is ~100 requests/hour).
# Free: https://doaj.org/apply-for-api-key/
# PAPER_SEARCH_MCP_DOAJ_API_KEY=

# Zenodo — only needed for private records.
# https://zenodo.org/account/settings/applications/
# PAPER_SEARCH_MCP_ZENODO_ACCESS_TOKEN=

# IEEE Xplore — activates metadata-only search. Does NOT grant full text.
# Free: https://developer.ieee.org/
# PAPER_SEARCH_MCP_IEEE_API_KEY=

# Google Scholar proxy — does not guarantee access and does not remove
# upstream limits. Scholar is rate-limited and CAPTCHA-prone; prefer
# OpenAlex or Semantic Scholar for discovery.
# PAPER_SEARCH_MCP_GOOGLE_SCHOLAR_PROXY_URL=
