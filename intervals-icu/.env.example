# Intervals.icu API Configuration
# Copy this file to .env and fill in your credentials

# Required: Your Intervals.icu API key
# Get it from: intervals.icu/settings → Developer Settings → Generate API key
API_KEY=your_intervals_api_key_here

# Required: Your Intervals.icu athlete ID (format: i123456)
# Find it in your profile URL or Settings page
ATHLETE_ID=i123456

# Optional: Override the API base URL (default shown)
# INTERVALS_API_BASE_URL=https://intervals.icu/api/v1

# Optional: MCP transport mode (default: stdio)
# Options: stdio, sse, streamable-http
# MCP_TRANSPORT=stdio
